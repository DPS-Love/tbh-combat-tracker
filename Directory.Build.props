<Project>

  <!--
    游戏路径，按顺序找（tools\find-game.ps1 是同一套规则）：
      1. 命令行 -p:GameDir="E:\Steam\steamapps\common\TaskbarHero"
      2. 环境变量 TBH_GAME_DIR
      3. Steam 默认库：注册表里的 SteamPath\steamapps\common\TaskbarHero
    游戏装在别的 Steam 库时用 1 或 2。
  -->
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">$(TBH_GAME_DIR)</GameDir>
    <_SteamPath Condition="'$(GameDir)' == '' And '$(OS)' == 'Windows_NT'">$(Registry:HKEY_CURRENT_USER\Software\Valve\Steam@SteamPath)</_SteamPath>
    <!-- SteamPath 是 d:/steam 这种正斜杠写法，规范一下，免得输出里斜杠混着用 -->
    <_SteamGameDir Condition="'$(_SteamPath)' != ''">$([System.IO.Path]::GetFullPath('$(_SteamPath)\steamapps\common\TaskbarHero'))</_SteamGameDir>
    <GameDir Condition="'$(_SteamGameDir)' != '' And Exists('$(_SteamGameDir)\TaskBarHero.exe')">$(_SteamGameDir)</GameDir>

    <!--
      CI 上没有游戏，只有一份从私有仓库检出的引用程序集，直接指过去：
          dotnet build ... -p:RefsOnly=true -p:BepInExDir=<路径>\BepInEx
    -->
    <BepInExDir Condition="'$(BepInExDir)' == ''">$(GameDir)\BepInEx</BepInExDir>
    <!-- 加载器本体和 Harmony -->
    <BepInExCoreDir>$(BepInExDir)\core</BepInExCoreDir>
    <!-- Il2CppInterop 生成的游戏代理程序集（首次启动游戏时生成） -->
    <BepInExInteropDir>$(BepInExDir)\interop</BepInExInteropDir>
    <PluginsDir>$(BepInExDir)\plugins</PluginsDir>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>portable</DebugType>
    <!-- Il2Cpp 代理程序集里有大量 obsolete / 无 XML 文档的成员，静音掉噪音 -->
    <NoWarn>$(NoWarn);CS0618;CS1591;CS0649;CS0169</NoWarn>
  </PropertyGroup>

</Project>
